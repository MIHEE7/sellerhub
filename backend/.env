NAVER_1_CLIENT_SECRET=your_naver_client_secret_1
NAVER_2_CLIENT_ID=your_naver_client_id_2
NAVER_2_CLIENT_SECRET=your_naver_client_secret_2
NAVER_3_CLIENT_ID=your_naver_client_id_3
NAVER_3_CLIENT_SECRET=your_naver_client_secret_3

# ── 쿠팡 Wing API ─────────────────────────────────
COUPANG_API_BASE=https://api-gateway.coupang.com
COUPANG_1_ACCESS_KEY=your_coupang_access_key_1
COUPANG_1_SECRET_KEY=your_coupang_secret_key_1
COUPANG_1_VENDOR_ID=your_vendor_id_1
COUPANG_2_ACCESS_KEY=your_coupang_access_key_2
COUPANG_2_SECRET_KEY=your_coupang_secret_key_2
